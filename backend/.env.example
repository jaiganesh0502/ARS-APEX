PROJECT_NAME="Discharge Orchestration System"
API_V1_STR="/api"
SECRET_KEY="development-secret-key-change-in-production"
ENVIRONMENT="development"
DEBUG=true

# Database Connection (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=discharge_orchestration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discharge_orchestration

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# AI discharge-draft generation (Replicate)
# Required locally; never commit a real token.
REPLICATE_API_TOKEN=
LLM_MODEL=openai/gpt-5.6-luna
LLM_REASONING_EFFORT=low
LLM_VERBOSITY=medium
LLM_MAX_COMPLETION_TOKENS=3000

# Other integrations (placeholders)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/
MAPS_API_KEY=
NOTIFICATION_SERVICE_URL=
