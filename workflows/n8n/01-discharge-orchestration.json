{
  "id": "wf_discharge_01",
  "name": "01 - Discharge Orchestration (Parallel Bed Release & Billing)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "report_approved",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook: report_approved",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300],
      "webhookId": "report_approved"
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/beds/{{ $json.body ? ($json.body.payload ? $json.body.payload.bed_id : $json.body.bed_id) : ($json.payload ? $json.payload.bed_id : $json.bed_id) }}/start-release",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'alta_prod_internal_secret_2026' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Branch A: Start Bed Release (Vacating)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [400, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/admissions/{{ $json.body ? ($json.body.payload ? $json.body.payload.admission_id : $json.body.admission_id) : ($json.payload ? $json.payload.admission_id : $json.admission_id) }}/billing-clearance",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'alta_prod_internal_secret_2026' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Branch B: Get / Create Billing Clearance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [400, 400]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/workflow-events/{{ $('Webhook: report_approved').first().json.body ? $('Webhook: report_approved').first().json.body.event_id : $('Webhook: report_approved').first().json.event_id }}/complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'alta_prod_internal_secret_2026' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Report Orchestration Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Webhook: report_approved": {
      "main": [
        [
          {
            "node": "Branch A: Start Bed Release (Vacating)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Branch B: Get / Create Billing Clearance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Branch A: Start Bed Release (Vacating)": {
      "main": [
        [
          {
            "node": "Report Orchestration Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}
