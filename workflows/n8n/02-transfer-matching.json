{
  "name": "02 - Transfer Matching (Starts Matching & Stops for Doctor Selection)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "clinical_transfer_decision_confirmed",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook: clinical_transfer_decision_confirmed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $headers['x-workflow-secret'] }}",
              "value2": "={{ $env.N8N_WEBHOOK_SECRET || 'change-me-in-production' }}"
            }
          ]
        }
      },
      "name": "Validate Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/admissions/{{ $json.payload.admission_id }}/start-transfer-matching",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'change-me-in-production' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Start Transfer Matching & Rank Facilities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [550, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/workflow-events/{{ $('Webhook: clinical_transfer_decision_confirmed').first().json.event_id }}/complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'change-me-in-production' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Report Matching Ready (Awaiting Doctor Selection)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [800, 300]
    }
  ],
  "connections": {
    "Webhook: clinical_transfer_decision_confirmed": {
      "main": [
        [
          {
            "node": "Validate Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Secret": {
      "main": [
        [
          {
            "node": "Start Transfer Matching & Rank Facilities",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Transfer Matching & Rank Facilities": {
      "main": [
        [
          {
            "node": "Report Matching Ready (Awaiting Doctor Selection)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}
