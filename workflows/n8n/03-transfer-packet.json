{
  "id": "wf_packet_03",
  "name": "03 - Transfer Packet (Prepares & Delivers Packet to Receiving Queue)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "receiving_hospital_selected",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook: receiving_hospital_selected",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $headers['x-workflow-secret'] }}",
              "value2": "={{ $env.N8N_WEBHOOK_SECRET || 'change-me-in-production' }}"
            }
          ]
        }
      },
      "name": "Validate Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/transfers/{{ $json.payload.transfer_id }}/prepare-packet",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'change-me-in-production' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Prepare Clinical Transfer Packet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/transfers/{{ $('Webhook: receiving_hospital_selected').first().json.payload.transfer_id }}/send-packet",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'change-me-in-production' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Send Packet to Destination Review Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [720, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/workflow-events/{{ $('Webhook: receiving_hospital_selected').first().json.event_id }}/complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'change-me-in-production' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Report Packet Delivered (Awaiting Receiving Doctor)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [950, 300]
    }
  ],
  "connections": {
    "Webhook: receiving_hospital_selected": {
      "main": [
        [
          {
            "node": "Validate Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Secret": {
      "main": [
        [
          {
            "node": "Prepare Clinical Transfer Packet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Clinical Transfer Packet": {
      "main": [
        [
          {
            "node": "Send Packet to Destination Review Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Packet to Destination Review Queue": {
      "main": [
        [
          {
            "node": "Report Packet Delivered (Awaiting Receiving Doctor)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}
