{
  "id": "wf_acceptance_04",
  "name": "04 - Transfer Acceptance (Ambulance Dispatch & Billing Branching)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "receiving_hospital_accepted",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook: receiving_hospital_accepted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300],
      "webhookId": "receiving_hospital_accepted"
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/transfers/{{ $json.body ? ($json.body.payload ? $json.body.payload.transfer_id : $json.body.transfer_id) : ($json.payload ? $json.payload.transfer_id : $json.transfer_id) }}/request-dispatch",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'alta_prod_internal_secret_2026' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Branch A: Request Ambulance Dispatch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [400, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/admissions/{{ $json.body ? ($json.body.payload ? $json.body.payload.admission_id : $json.body.admission_id) : ($json.payload ? $json.payload.admission_id : $json.admission_id) }}/defer-billing",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'alta_prod_internal_secret_2026' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Branch B: Defer Billing Clearance (Emergency Path)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [400, 400]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/workflow-events/{{ $('Webhook: receiving_hospital_accepted').first().json.body ? $('Webhook: receiving_hospital_accepted').first().json.body.event_id : $('Webhook: receiving_hospital_accepted').first().json.event_id }}/complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'alta_prod_internal_secret_2026' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Report Acceptance Orchestration Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Webhook: receiving_hospital_accepted": {
      "main": [
        [
          {
            "node": "Branch A: Request Ambulance Dispatch",
            "type": "main",
            "index": 0
          },
          {
            "node": "Branch B: Defer Billing Clearance (Emergency Path)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Branch A: Request Ambulance Dispatch": {
      "main": [
        [
          {
            "node": "Report Acceptance Orchestration Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}
