{
  "name": "04 - Transfer Acceptance (Ambulance Dispatch & Billing Branching)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "receiving_hospital_accepted",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook: receiving_hospital_accepted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $headers['x-workflow-secret'] }}",
              "value2": "={{ $env.N8N_WEBHOOK_SECRET || 'change-me-in-production' }}"
            }
          ]
        }
      },
      "name": "Validate Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [280, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.payload.emergency }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Is Emergency Priority?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/transfers/{{ $('Webhook: receiving_hospital_accepted').first().json.payload.transfer_id }}/dispatch-ambulance",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'change-me-in-production' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Emergency Branch: Immediate Ambulance Dispatch (Billing Bypassed)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [750, 180]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/transfers/{{ $('Webhook: receiving_hospital_accepted').first().json.payload.transfer_id }}/dispatch-ambulance",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'change-me-in-production' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Non-Emergency Branch A: Ambulance Dispatch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [750, 380]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/admissions/{{ $('Webhook: receiving_hospital_accepted').first().json.payload.admission_id }}/billing-clearance",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'change-me-in-production' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Non-Emergency Branch B: Track Billing Clearance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [750, 520]
    },
    {
      "parameters": {
        "url": "={{ $env.FASTAPI_INTERNAL_URL || 'http://backend:8000/api/internal' }}/workflow-events/{{ $('Webhook: receiving_hospital_accepted').first().json.event_id }}/complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY || 'change-me-in-production' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Report Acceptance Orchestrated",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Webhook: receiving_hospital_accepted": {
      "main": [
        [
          {
            "node": "Validate Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Secret": {
      "main": [
        [
          {
            "node": "Is Emergency Priority?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Emergency Priority?": {
      "main": [
        [
          {
            "node": "Emergency Branch: Immediate Ambulance Dispatch (Billing Bypassed)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Non-Emergency Branch A: Ambulance Dispatch",
            "type": "main",
            "index": 0
          },
          {
            "node": "Non-Emergency Branch B: Track Billing Clearance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Emergency Branch: Immediate Ambulance Dispatch (Billing Bypassed)": {
      "main": [
        [
          {
            "node": "Report Acceptance Orchestrated",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Non-Emergency Branch A: Ambulance Dispatch": {
      "main": [
        [
          {
            "node": "Report Acceptance Orchestrated",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}
