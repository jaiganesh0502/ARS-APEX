# Environment configuration template for local development

# Backend settings
PROJECT_NAME="Discharge Orchestration System"
API_V1_STR="/api"
SECRET_KEY="development-secret-key-change-in-production"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=discharge_orchestration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discharge_orchestration

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend settings
VITE_API_URL=http://localhost:8000/api

# Orchestration & n8n
ORCHESTRATION_MODE=manual
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/
N8N_WEBHOOK_SECRET=change-me-in-production
INTERNAL_API_KEY=change-me-in-production
N8N_TIMEOUT_SECONDS=5.0
N8N_MAX_RETRIES=3

# Future Integrations (Placeholders)
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.6-luna
MAPS_API_KEY=
NOTIFICATION_SERVICE_URL=
